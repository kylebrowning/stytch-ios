 a user logs in or out of your app."}],"type":"topic","role":"project","kind":"project","estimatedTime":"5min"},"01-send-tokens-in-auth-header-01.swift":{"highlights":[],"fileName":"NetworkingClient.swift","syntax":"swift","type":"file","fileType":"swift","content":["import Foundation","","final class NetworkingClient {","    private let session = URLSession(configuration: .default)","","    func performRequest(_ method: Method, url: URL) async throws -> (Data, URLResponse) {","        let request = urlRequest(url: url, method: method)","        return try await session.data(for: request)","    }","","    private func urlRequest(url: URL, method: Method) -> URLRequest {","        var request: URLRequest = .init(url: url)","","        request.httpMethod = method.stringValue","","        switch method {","        case .get, .delete:","            break","        case let .post(data), let .put(data):","            request.httpBody = data","        }","","        return request","    }","}"],"identifier":"01-send-tokens-in-auth-header-01.swift"},"doc://stytch-ios.StytchCore/tutorials/StytchCore/add-oauth":{"kind":"project","title":"Add OAuth","abstract":[{"text":"Using OAuth, or social logins, are a familiar and low-friction way to authenticate your users. Learn how to add them in this tutorial!","type":"text"}],"estimatedTime":"5min","type":"topic","url":"\/tutorials\/stytchcore\/add-oauth","role":"project","identifier":"doc:\/\/stytch-ios.StytchCore\/tutorials\/StytchCore\/add-oauth"},"01-send-tokens-in-auth-header-05.swift":{"identifier":"01-send-tokens-in-auth-header-05.swift","highlights":[{"line":13}],"fileName":"AppDelegate.swift","content":["import StytchCore","import UIKit","","@UIApplicationMain","final class AppDelegate: NSObject, UIApplicationDelegate {","    let networkingClient: NetworkingClient = .init()","","    func application(","        _ application: UIApplication,","        didFinishLaunchingWithOptions launchOptions: [UIApplication.LaunchOptionsKey : Any]? = nil","    ) -> Bool {","        StytchClient.configure(publicToken: publicToken)","        networkingClient.headerProvider = { [:] }","        return true","    }","}"],"syntax":"swift","fileType":"swift","type":"file"},"doc://stytch-ios.StytchCore/tutorials/StytchCore/initial-setup#Configure-the-StytchClient":{"kind":"section","abstract":[{"text":"This tutorial will walk you through the initial process for setting up the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/stytch-ios.StytchCore\/documentation\/StytchCore\/StytchClient","type":"reference"},{"text":".","type":"text"}],"type":"section","identifier":"doc:\/\/stytch-ios.StytchCore\/tutorials\/StytchCore\/initial-setup#Configure-the-StytchClient","role":"pseudoSymbol","url":"\/tutorials\/stytchcore\/initial-setup#Configure-the-StytchClient","title":"Configure the StytchClient"},"doc://stytch-ios.StytchCore/tutorials/StytchCore/manage-the-current-user#Get-current-user":{"kind":"section","abstract":[{"text":"This tutorial will teach you a few of the things you can do to manage Stytch users.","type":"text"}],"url":"\/tutorials\/stytchcore\/manage-the-current-user#Get-current-user","type":"section","role":"pseudoSymbol","identifier":"doc:\/\/stytch-ios.StytchCore\/tutorials\/StytchCore\/manage-the-current-user#Get-current-user","title":"Get current user"},"doc://stytch-ios.StytchCore/tutorials/StytchCore/step-up-auth-mfa#Utilizing-a-just-in-time-second-factor":{"url":"\/tutorials\/stytchcore\/step-up-auth-mfa#Utilizing-a-just-in-time-second-factor","kind":"section","identifier":"doc:\/\/stytch-ios.StytchCore\/tutorials\/StytchCore\/step-up-auth-mfa#Utilizing-a-just-in-time-second-factor","role":"pseudoSymbol","abstract":[{"type":"text","text":"If your app has functionality which requires higher levels of security on certain screens vs others, you may want to consider using step-up authentication or MFA. This tutorial will teach you a simple way of doing this with Stytch."}],"type":"section","ti