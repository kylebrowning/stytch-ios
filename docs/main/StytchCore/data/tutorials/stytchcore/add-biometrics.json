-auth-mfa#Confirm-the-one-time-code":{"title":"Confirm the one-time-code","abstract":[{"text":"If your app has functionality which requires higher levels of security on certain screens vs others, you may want to consider using step-up authentication or MFA. This tutorial will teach you a simple way of doing this with Stytch.","type":"text"}],"role":"pseudoSymbol","kind":"section","identifier":"doc:\/\/stytch-ios.StytchCore\/tutorials\/StytchCore\/step-up-auth-mfa#Confirm-the-one-time-code","type":"section","url":"\/tutorials\/stytchcore\/step-up-auth-mfa#Confirm-the-one-time-code"},"doc://stytch-ios.StytchCore/tutorials/StytchCore/manage-sessions-manually#Update-Session-tokens-using-updatesessionTokens":{"url":"\/tutorials\/stytchcore\/manage-sessions-manually#Update-Session-tokens-using-updatesessionTokens","role":"pseudoSymbol","abstract":[{"type":"text","text":"If the out-of-the-box sessions product doesn’t work for your needs, there are options available for manual intervention and manipulation."}],"kind":"section","title":"Update Session tokens using update(sessionTokens:)","identifier":"doc:\/\/stytch-ios.StytchCore\/tutorials\/StytchCore\/manage-sessions-manually#Update-Session-tokens-using-updatesessionTokens","type":"section"},"doc://stytch-ios.StytchCore/tutorials/StytchCore/initial-setup":{"title":"Initial setup","url":"\/tutorials\/stytchcore\/initial-setup","kind":"project","identifier":"doc:\/\/stytch-ios.StytchCore\/tutorials\/StytchCore\/initial-setup","abstract":[{"text":"This tutorial will walk you through the initial process for setting up the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/stytch-ios.StytchCore\/documentation\/StytchCore\/StytchClient"},{"text":".","type":"text"}],"type":"topic","role":"project","estimatedTime":"5min"},"01-add-biometrics-06.swift":{"fileType":"swift","content":["import StytchCore","import UIKit","","final class AuthenticationViewController: UIViewController {","    var onAuthenticate: ((AuthenticateResponseType) -> Void)?","","    private let biometricsButton: UIButton","","    override func viewDidLoad() {","        super.viewDidLoad()","","        biometricsButton.addTarget(self, action: #selector(didTapBiometricsButton(sender:)), for: [.touchUpInside])","        ...","    }","","    private func handleAuthentication(response: AuthenticateResponseType) {","        if canPerformBiometricCheck(), !StytchClient.biometrics.registrationAvailable {","            promptForBiometricsRegistration(user: response.user)","        }","        onAuthenticate(response)","    }","","    private func promptForBiometricRegistration(user: User) {","        let message = \"Register for Biometrics!\"","        let alertController = UIAlertController(title: nil, message: message, preferredStyle: .alert)","        alertController.addAction(.init(title: \"OK\", style: .default) { [weak self] _ in","            self?.registerBiometrics(identifier: user.emails.first?.email ?? user.id.rawValue)","        })","        present(alertController, animated: true)","    }","","    private func registerBiometrics(identifier: String) {","        Task {","            do {","                let authResponse = try await StytchClient.biometrics.register(parameters: .init(identifier: identifier))","                handleAuthentication(response: authResponse)","            } catch {}","        }","    }","","    private func updateBiometricsButtonHidden() {","        guard canPerformBiometricCheck(), StytchClient.biometrics.registrationAvailable else {","            biometricsButton.isHidden = true","            return","        }","","        biometricsButton.isHidden = false","    }","","    @objc private func didTapBiometricsButton(sender: UIButton) {","        Task {","            do {","                let authResponse = try await StytchClient.biometrics.authenticate(parameters: .init())","                handleAuthentication(response: authResponse)","            } catch {}","        }","    }","","    private func canPerformBiometricCheck() -> Bool {","        var error: NSError?","        guard LAContext().canEvaluatePolicy(.deviceOwnerAuthenticationWithBiometrics, error: &error), error == nil else {","            return false","        }","        return true","    }","}"],"type":"file","syntax":"swift","identifier":"01-add-biometrics-06.swift","fileName":"AuthenticationViewController.swift","highlights":[{"line":27},{"line":32},{"line":33},{"line":34},{"line":35},{"line":36},{"line":37},{"line":38},{"line":39},{"line":40}]},"doc://stytch-ios.StytchCore/tutorials/StytchCore/rebuild-ui-on-auth-change":{"url":"\/tutorials\/stytchcore\/rebuild-ui-on-auth-change","estimatedTime":"5min","kind":"project","title":"Rebuild your UI based on changes to auth status","role":"project","identifier":"doc:\/\/stytch-ios.StytchCore\/tutorials\/StytchCore\/rebuild-ui-on-auth-change","type":"topic","abstract":[{"text":"Stytch provides a combine publisher to enable you to reactively set up or tear down your UI when a user logs in or out of your app.","type":"text"}]},"doc://stytch-ios.StytchCore/tutorials/StytchCore/step-up-auth-mfa":{"role":"project","kind":"project","estimatedTime":"10min","identifier":"doc:\/\/stytch-ios.StytchCore\/tutorials\/StytchCore\/step-up-auth-mfa","url":"\/tutorials\/stytchcore\/step-up-auth-mfa","title":"Step up auth\/MFA","type":"topic","abstract":[{"text":"If your app has functionality which requires higher levels of security on certain screens vs others, you may want to consider using step-up authentication or MFA. This tutorial will teach you a simple way of doing this with Stytch.","type":"text"}]},"doc://stytch-ios.StytchCore/tutorials/StytchCore/rebuild-ui-on-auth-change#Dynamically-rebuild-your-UI":{"title":"Dynamically rebuild your UI","kind":"section","role":"pseudoSymbol","abstract":[{"type":"text","text":"Stytch provides a combine publisher to enable you to reactively set up or tear down your UI when a user logs in or