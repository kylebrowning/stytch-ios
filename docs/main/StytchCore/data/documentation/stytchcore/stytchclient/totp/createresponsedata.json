. The authenticator app can then generate TOTPs that are valid for a specific amount of time (generally 30 seconds). The end user inputs the TOTP and the developer can use the authenticate method to verify that the TOTP is valid. To call these methods, TOTPs must be enabled in the "},{"type":"reference","identifier":"https:\/\/stytch.com\/dashboard\/sdk-configuration","isActive":true},{"type":"text","text":" of the Stytch dashboard."}],"navigatorTitle":[{"kind":"identifier","text":"TOTP"}],"type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"TOTP"}]},"doc://stytch-ios.StytchCore/documentation/StytchCore/StytchClient/TOTP/CreateResponseData/secret":{"identifier":"doc:\/\/stytch-ios.StytchCore\/documentation\/StytchCore\/StytchClient\/TOTP\/CreateResponseData\/secret","role":"symbol","title":"secret","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"secret","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"}],"kind":"symbol","type":"topic","url":"\/documentation\/stytchcore\/stytchclient\/totp\/createresponsedata\/secret","abstract":[]},"doc://stytch-ios.StytchCore/Se":{"type":"unresolvable","identifier":"doc:\/\/stytch-ios.StytchCore\/Se","title":"Swift.Decodable"},"doc://stytch-ios.StytchCore/documentation/StytchCore/StytchClient/TOTP/CreateResponseData/init(from:)":{"identifier":"doc:\/\/stytch-ios.StytchCore\/documentation\/StytchCore\/StytchClient\/TOTP\/CreateResponseData\/init(from:)","role":"symbol","title":"init(from:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":": any ","kind":"text"},{"preciseIdentifier":"s:s7DecoderP","text":"Decoder","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"}],"kind":"symbol","type":"topic","url":"\/documentation\/stytchcore\/stytchclient\/