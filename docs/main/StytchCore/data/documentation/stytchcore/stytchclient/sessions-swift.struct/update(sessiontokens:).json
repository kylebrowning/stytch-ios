":"text","text":"NOTE"}]},{"type":"text","text":": - After a successful authentication, the session will be automatically refreshed in the background to ensure the sessionJwt remains valid (it expires after 5 minutes.) Session polling will be stopped after a session is revoked or after an unauthenticated error response is received."}],"title":"StytchClient.Sessions","url":"\/documentation\/stytchcore\/stytchclient\/sessions-swift.struct","navigatorTitle":[{"text":"Sessions","kind":"identifier"}]},"doc://stytch-ios.StytchCore/documentation/StytchCore/StytchClient/Sessions-swift.struct/update(sessionTokens:)":{"identifier":"doc:\/\/stytch-ios.StytchCore\/documentation\/StytchCore\/StytchClient\/Sessions-swift.struct\/update(sessionTokens:)","abstract":[{"type":"text","text":"If your app has cookies disabled or simply receives updated session tokens from your backend via means other than"},{"type":"text","text":" "},{"type":"codeVoice","code":"Set-Cookie"},{"type":"text","text":" headers, you must call this method after receiving the updated tokens to ensure the "},{"type":"codeVoice","code":"StytchClient"},{"type":"text","text":" "},{"type":"text","text":"and persistent storage are kept up-to-date. You are required to include both the opaque token and the jwt."}],"type":"topic","kind":"symbol","url":"\/documentation\/stytchcore\/stytchclient\/sessions-swift.struct\/update(sessiontokens:)","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"update"},{"kind":"text","text":"("},{"kind":"externalParam","text":"sessionTokens"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:10StytchCore13SessionTokensV","text":"SessionTokens"},{"kind":"text","text":")"}],"title":"update(sessionTokens:)"},"doc://stytch-ios.StytchCore/documentation/StytchCore/StytchClient":{"type":"topic","abstract":[{"type":"text","text":"The entrypoint for all Stytch-related interaction."}],"role":"symbol","title"