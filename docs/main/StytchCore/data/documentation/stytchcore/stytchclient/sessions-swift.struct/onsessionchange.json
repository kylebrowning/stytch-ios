t"},{"text":"onSessionChange","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7Combine12AnyPublisherV","text":"AnyPublisher","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:10StytchCore0A10ObjectInfoO","text":"StytchObjectInfo","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:10StytchCore7SessionV","text":"Session","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"preciseIdentifier":"s:s5NeverO","text":"Never","kind":"typeIdentifier"},{"text":">","kind":"text"}]},"doc://stytch-ios.StytchCore/documentation/StytchCore/Session":{"kind":"symbol","identifier":"doc:\/\/stytch-ios.StytchCore\/documentation\/StytchCore\/Session","role":"symbol","navigatorTitle":[{"text":"Session","kind":"identifier"}],"type":"topic","abstract":[{"type":"text","text":"A type defining a session; including information about its validity, expiry, factors associated with this session, and more."}],"title":"Session","url":"\/documentation\/stytchcore\/session","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Session","kind":"identifier"}]},"doc://stytch-ios.StytchCore/documentation/StytchCore/StytchClient/Sessions-swift.struct":{"role":"symbol","title":"StytchClient.Sessions","navigatorTitle":[{"text":"Sessions","kind":"identifier"}],"type":"topic","url":"\/documentation\/stytchcore\/stytchclient\/sessions-swift.struct","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sessions","kind":"identifier"}],"abstract":[{"text":"The SDK may be used to check whether a user has a cached session, view the current session, refresh the session, and revoke the session. To authenticate a session on your backend, you must use either the Stytch API or a Stytch server-side library. ","type":"text"},{"type":"strong","inlineContent":[{"text":"NOTE","type":"text"}]},{"text":": - After a successful authentication, the session will be automatically refreshed in the background to ensure the sessionJwt remains valid (it expires after 5 minutes.) Session polling will be stopped after a session is revoked or after an unauthenticated error response is received.","type":"text"}],"identifier":"doc:\/\/stytch-ios.StytchCore\/documentation\/StytchCore\/StytchClient\/Sessions-swift.struct","kind":"symbol"},"doc://stytch-ios.StytchCore/documentation/StytchCore/StytchObjectInfo":{"kind":"symbol","abstract":[{"type":"text","text":"StytchObjectInfo provides a generic way to unify the publishing of Stytch object types."},{"type":"text","text":" "},{"type":"text","text":"If there is an object to publish you will get "},{"type":"codeVoice","code":"case available(T, Date)"},{"type":"text","text":", which will publish the object"},{"type":"text","text":" "},{"type":"text","text":"and the date is was last validated at. The receiver of the event if the object is within their time tolerance for use."},{"type":"text","text":" "},{"type":"text","text":"If there is no object to publish you will get "},{"type":"codeVoice","code":"case unavailable(KeychainError?)"},{"type":"text","text":". So the publisher will never have to publish a nil value."}],"title":"StytchObjectInfo","type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"StytchObjectInfo","kind":"identifier"}],"navigatorTitle":[{"text":"StytchObjectInfo","kind":"identifier"}],"url":"\/documentation\/stytchcore\/stytchobjectinfo","role":"symbol","identifier":"doc:\/\/stytch-ios.StytchCore\/documentation\/StytchCore\/StytchObjectInfo"},"doc://stytch-ios.StytchCore/documentation/StytchCore":{"type":"topic","title":"StytchCore","abstract":[{"type":"text","text":"Provides native iOS access to the Stytch SDK methods for ultimate flexibility."}],"url":"\/documentation\/stytchcore","kind":"symbol","identifier":"doc:\/\/stytch-ios.StytchCore\/documentation\/StytchCore","role":"collection"}}}