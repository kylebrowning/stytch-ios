ode":"case available(T, Date)"},{"type":"text","text":", which will publish the object"},{"type":"text","text":" "},{"type":"text","text":"and the date is was last validated at. The receiver of the event if the object is within their time tolerance for use."},{"type":"text","text":" "},{"type":"text","text":"If there is no object to publish you will get "},{"type":"codeVoice","code":"case unavailable(KeychainError?)"},{"type":"text","text":". So the publisher will never have to publish a nil value."}],"type":"topic","title":"StytchObjectInfo","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"StytchObjectInfo","kind":"identifier"}]},"doc://stytch-ios.StytchCore/documentation/StytchCore/StytchClient/Sessions-swift.struct/onSessionChange":{"type":"topic","title":"onSessionChange","role":"symbol","abstract":[{"text":"A publisher which emits following a change in authentication status and returns either the opaque session token or nil. You can use this as an indicator to set up or tear down your UI accordingly.","type":"text"}],"identifier":"doc:\/\/stytch-ios.StytchCore\/documentation\/StytchCore\/StytchClient\/Sessions-swift.struct\/onSessionChange","url":"\/documentation\/stytchcore\/stytchclient\/sessions-swift.struct\/onsessionchange","kind":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"onSessionChange","kind":"identifier"},{"text":": ","kind":"text"},{"text":"AnyPublisher","kind":"typeIdentifier","preciseIdentifier":"s:7Combine12AnyPublisherV"},{"text":"<","kind":"text"},{"text":"StytchObjectInfo","kind":"typeIdentifier","preciseIdentifier":"s:10StytchCore0A10ObjectInfoO"},{"text":"<","kind":"text"},{"text":"Session","kind":"typeIdentifier","preciseIdentifier":"s:10StytchCore7SessionV"},{"text":">, ","kind":"text"},{"text":"Never","kind":"typeIdentifier","preciseIdentifier":"s:s5NeverO"},{"text":">","kind":"text"}]}}}