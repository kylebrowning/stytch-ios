{"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"symbol","primaryContentSections":[{"declarations":[{"tokens":[{"text":"init","kind":"keyword"},{"text":"(","kind":"text"},{"text":"oauthToken","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"sessionDurationMinutes","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:10StytchCore7MinutesV","text":"Minutes","identifier":"doc:\/\/stytch-ios.StytchCore\/documentation\/StytchCore\/Minutes","kind":"typeIdentifier"},{"text":" = .defaultSessionDuration, ","kind":"text"},{"text":"locale","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:10StytchCore0A6LocaleO","identifier":"doc:\/\/stytch-ios.StytchCore\/documentation\/StytchCore\/StytchLocale","text":"StytchLocale","kind":"typeIdentifier"},{"text":" = .en)","kind":"text"}],"languages":["swift"],"platforms":["iOS"]}],"kind":"declarations"},{"parameters":[{"content":[{"inlineContent":[{"text":"The token to authenticate.","type":"text"}],"type":"paragraph"}],"name":"oauthToken"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Set the session lifetime to be this many minutes from now. This will start a new session if one doesn’t already exist, returning both an opaque session_token and session_jwt for this session. Remember that the session_jwt will have a fixed lifetime of five minutes regardless of the underlying session duration, and will need to be refreshed over time."},{"type":"text","text":" "},{"type":"text","text":"This value must be a minimum of 5 and a maximum of 527040 minutes (366 days)."},{"type":"text","text":" "},{"type":"text","text":"If a session_token or session_jwt is provided then a successful authentication will continue to extend the session this many minutes."},{"type":"text","text":" "},{"type":"text","text":"If the session_duration_minutes parameter is not specified, a Stytch session will be created with a 60 minute duration. If you don’t want to use the Stytch session product, you can ignore the session fields in the response."}]}],"name":"sessionDurationMinutes"},{"content":[{"inlineContent":[{"type":"text","text":"If the Member needs to complete an MFA step, and the Member has a phone number, this endpoint will pre-emptively send a one-time passcode (OTP) to the Member’s phone number. The locale argument will be used to determine which language to use when sending the passcode."},{"type":"text","text":" "},{"type":"text","text":"Parameter is a IETF BCP 47 language tag, e.g. “en”."},{"type":"text","text":" "},{"type":"text","text":"Currently supported languages are English (“en”), Spanish (“es”), and Brazilian Portuguese (“pt-br”); if no value is provided, the copy defaults to English."},{"type":"text","text":" "},{"type":"text","text":"Request support for additional languages here (https:\/\/docs.google.com\/forms\/d\/e\/1FAIpQLScZSpAu_m2AmLXRT3F3kap-s_mcV6UTBitYn6CdyWP0-o7YjQ\/viewform?usp=sf_link%22)!"}],"type":"paragraph"}],"name":"locale"}],"kind":"parameters"}],"sections":[],"metadata":{"externalID":"s:10StytchCore0A9B2BClientV5OAuthV22AuthenticateParametersV10oauthToken22sessionDurationMinutes6localeAGSS_AA0L0VAA0A6LocaleOtcfc","symbolKind":"init","modules":[{"name":"StytchCore"}],"fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"oauthToken","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"sessionDurationMinutes","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Minutes","kind":"typeIdentifier","preciseIdentifier":"s:10StytchCore7MinutesV"},{"text":", ","kind":"text"},{"text":"locale","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"StytchLocale","kind":"typeIdentifier","preciseIdentifier":"s:10StytchCore0A6LocaleO"},{"text":")","kind":"text"}],"roleHead