ation, in minutes, for the requested session. Defaults to 5 minutes.","type":"text"}]}]},{"name":"organizationName","content":[{"inlineContent":[{"text":"The name of the Organization. If the name is not specified, a default name will be created based on the email used to initiate the discovery flow. If the email domain is a common email provider such as gmail.com, or if the email is a .edu email, the organization name will be generated based on the name portion of the email. Otherwise, the organization name will be generated based on the email domain.","type":"text"}],"type":"paragraph"}]},{"name":"organizationSlug","content":[{"inlineContent":[{"type":"text","text":"The unique URL slug of the Organization. A minimum of two characters is required. The slug only accepts alphanumeric characters and the following reserved characters: - . _ ~. If the slug is not specified, a default slug will be created based on the email used to initiate the discovery flow. If the email domain is a common email provider such as gmail.com, or if the email is a .edu email, the organization slug will be generated based on the name portion of the email. Otherwise, the organization slug will be generated based on the email domain."}],"type":"paragraph"}]},{"name":"organizationLogoUrl","content":[{"type":"paragraph","inlineContent":[{"text":"The image URL of the Organization logo.","type":"text"}]}]},{"name":"ssoJitProvisioning","content":[{"type":"paragraph","inlineContent":[{"text":"The authentication setting that controls the JIT provisioning of Members when authenticating via SSO.","type":"text"}]}]},{"name":"emailAllowedDomains","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"An array of email domains that allow invites or JIT provisioning for new Members. This list is enforced when either "},{"type":"codeVoice","code":"email_invites"},{"type":"text","text":" or "},{"type":"codeVoice","code":"email_jit_provisioning"},{"type":"text","text":" is set to "},{"type":"codeVoice","code":"RESTRICTED"},{"type":"text","text":"."}]}]},{"name":"emailJitProvisioning","content":[{"type":"paragraph","inlineContent":[{"text":"The authentication setting that controls how a new Member can be provisioned by authenticating via Email Magic Link.","type":"text"}]}]},{"name":"emailInvites","content":[{"type":"paragraph","inlineContent":[{"text":"The authentication setting that controls how a new Member can be invited to an organization by email.","type":"text"}]}]},{"name":"authMethods","content":[{"inlineContent":[{"text":"The setting that controls which authentication methods can be used by Members of an Organization.","type":"text"}],"type":"paragraph"}]},{"name":"allowedAuthMethods","content":[{"inlineContent":[{"type":"text","text":"An array of allowed authentication methods. This list is enforced when "},{"type":"codeVoice","code":"auth_methods"},{"type":"text","text":" is set to "},{"type":"codeVoice","code":"RESTRICTED"},{"type":"text","text":"."}],"type":"paragraph"}]}]}],"identifier":{"url":"doc:\/\/stytch-ios.StytchCore\/documentation\/StytchCore\/StytchB2BClient\/Discovery-swift.struct\/CreateOrganizationParameters\/init(sessionDurationMinutes:organizationName:organizationSlug:organizationLogoUrl:ssoJitProvisioning:emailAllowedDomains:emailJitProvisioning:emailInvites:authMethods:allowedAuthMethods:)","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/stytch-ios.StytchCore\/documentation\/StytchCore","doc:\/\/stytch-ios.StytchCore\/documentation\/StytchCore\/StytchB2BClient","doc:\/\/stytch-ios.StytchCore\/documentation\/StytchCore\/StytchB2BClient\/Discovery-swift.struct","doc:\/\/stytch-ios.StytchCore\/documentation\/StytchCore\/StytchB2BClient\/Discovery-swift.struct\/CreateOrganizationParameters"]]},"references":{"doc://stytch-ios.StytchCore/documentation/StytchCore/StytchB2BClient/EmailJitProvisioning":{"type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"e