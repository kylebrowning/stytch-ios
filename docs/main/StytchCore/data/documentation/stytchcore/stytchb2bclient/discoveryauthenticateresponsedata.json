//stytch-ios.StytchCore/documentation/StytchCore/StytchB2BClient/DiscoveryAuthenticateResponseData/intermediateSessionToken":{"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"intermediateSessionToken","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"}],"url":"\/documentation\/stytchcore\/stytchb2bclient\/discoveryauthenticateresponsedata\/intermediatesessiontoken","identifier":"doc:\/\/stytch-ios.StytchCore\/documentation\/StytchCore\/StytchB2BClient\/DiscoveryAuthenticateResponseData\/intermediateSessionToken","kind":"symbol","title":"intermediateSessionToken","abstract":[{"text":"The Intermediate Session Token. This token does not necessarily belong to a specific instance of a Member, but represents a bag of factors that may be converted to a member session.","type":"text"},{"text":" ","type":"text"},{"text":"The token can be used with the OTP SMS Authenticate endpoint, TOTP Authenticate endpoint, or Recovery Codes Recover endpoint to complete an MFA flow and log in to the Organization.","type":"text"},{"text":" ","type":"text"},{"text":"It can also be used with the Exchange Intermediate Session endpoint to join a specific Organization that allows the factors represented by the intermediate session token;","type":"text"},{"text":" ","type":"text"},{"text":"or the Create Organization via Discovery endpoint to create a new Organization and Member.","type":"text"}],"type":"topic","role":"symbol"},"doc://stytch-ios.StytchCore/documentation/StytchCore/StytchB2BClient/DiscoveryAuthenticateResponseData/discoveredOrganizations":{"kind":"symbol","url":"\/documentation\/stytchcore\/stytchb2bclient\/discoveryauthenticateresponsedata\/discoveredorganizations","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"discoveredOrganizations","kind":"identifier"},{"text":": [","kind":"text"},{"text":"StytchB2BClient","preciseIdentifier":"s:10StytchCore0A9B2BClientV","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"DiscoveredOrganization","preciseIdentifier":"s:10StytchCore0A9B2BClientV22DiscoveredOrganizationV","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"identifier":"doc:\/\/stytch-ios.StytchCore\/documentation\/StytchCore\/StytchB2BClient\/DiscoveryAuthenticateResponseData\/discoveredOrganizations","title":"discoveredOrganizations","role":"symbol","abstract":[{"type":"text","text":"An array of discovered_organization objects tied to the intermediate_session_token, session_token, or session_jwt. See the Discovered Organization Object for complete details."},{"type":"text","text":" "},{"type":"text","text":"Note that Organizations will only appear here under any of the following conditions:"},{"type":"text","text":" "},{"type":"text","text":"The end user is already a Member of the Organization."},{"type":"text","text":" "},{"type":"text","text":"The end user is invited to the Organization."},{"type":"text","text":" "},{"type":"text","text":"The end user can join the Organization because:"},{"type":"text","text":" "},{"type":"text","text":"a) The Organization allows JIT provisioning."},{"type":"text","text":" "},{"type":"text","text":"b) The Organizations’ allowed domains list contains the Member’s email domain."},{"type":"text","text":" "},{"type":"text","text":"c) The Organization has at least one other Member with a verified email address with the same domain as the end user (to prevent phishing attacks)."}],"type":"topic"},"doc://stytch-ios.StytchCore/documentation/StytchCore/StytchB2BClient/DiscoveryAuthenticateResponseData":{"role":"symbol","abstract":[],"type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DiscoveryAuthenticateResponseData"}],"navigatorTitle":[{"kind":"identifier","text":"DiscoveryAuthenticateResponseData"}],"identifier":"doc:\/\/stytch-ios.StytchCore\/documentation\/StytchCore\/StytchB2BClient\/