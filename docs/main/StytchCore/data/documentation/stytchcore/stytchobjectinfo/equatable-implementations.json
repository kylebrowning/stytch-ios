tytchCore/documentation/StytchCore/StytchObjectInfo":{"kind":"symbol","abstract":[{"type":"text","text":"StytchObjectInfo provides a generic way to unify the publishing of Stytch object types."},{"type":"text","text":" "},{"type":"text","text":"If there is an object to publish you will get "},{"type":"codeVoice","code":"case available(T, Date)"},{"type":"text","text":", which will publish the object"},{"type":"text","text":" "},{"type":"text","text":"and the date is was last validated at. The receiver of the event if the object is within their time tolerance for use."},{"type":"text","text":" "},{"type":"text","text":"If there is no object to publish you will get "},{"type":"codeVoice","code":"case unavailable(KeychainError?)"},{"type":"text","text":". So the publisher will never have to publish a nil value."}],"title":"StytchObjectInfo","type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"StytchObjectInfo","kind":"identifier"}],"navigatorTitle":[{"text":"StytchObjectInfo","kind":"identifier"}],"url":"\/documentation\/stytchcore\/stytchobjectinfo","role":"symbol","identifier":"doc:\/\/stytch-ios.StytchCore\/documentation\/StytchCore\/StytchObjectInfo"}}}